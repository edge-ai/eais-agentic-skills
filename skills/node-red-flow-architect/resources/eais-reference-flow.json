  {
    "id": "ba694548e65a205d",
    "type": "function",
    "z": "a13c98ef4bcfdb60",
    "name": "Sine wave",
    "func": "if (context.get('i') === undefined) context.set('i', 0);\nlet i = context.get('i');\n\n// Sine wave between 0 and 100\nlet value = Math.round((Math.sin(i / 10) + 1) * 50);\n\n// Return JSON payload\nmsg.payload = { value: value };\n\ncontext.set('i', i + 1);\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 170,
