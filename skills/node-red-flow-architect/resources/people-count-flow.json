[
  {"id":"people-tab","type":"tab","label":"Synthetic people count (draft)","disabled":false,"info":"Two synthetic sources: 0 and 1. No station operations. Configure callback selections and an approved UIBuilder instance before deployment."},
  {"id":"people-server","type":"eais-server","name":"Configure approved station","deploymentMode":"local","deviceUrl":"","allowInsecureTls":true},
  {"id":"people-callback","type":"callback","z":"people-tab","name":"Configure approved test pipeline","server":"people-server","pipelineId":"","command":"subscribe","obj":"true","timeout":0,"enrichMetadata":false,"x":140,"y":80,"wires":[["people-parse","people-raw"]]},
  {"id":"people-raw","type":"debug","z":"people-tab","name":"Inspect complete callback","active":true,"complete":"true","targetType":"full","x":400,"y":40,"wires":[]},
  {"id":"people-valid","type":"inject","z":"people-tab","name":"Test: source 0 fault, source 1 normal","props":[{"p":"payload"}],"payload":"{\"0\":{\"source_id\":0,\"obj_counter\":{\"person\":{\"max_val\":3}}},\"1\":{\"source_id\":1,\"obj_counter\":{\"person\":{\"max_val\":1}}}}","payloadType":"json","once":false,"repeat":"","crontab":"","x":180,"y":160,"wires":[["people-parse"]]},
  {"id":"people-zero","type":"inject","z":"people-tab","name":"Test: valid zero counts","props":[{"p":"payload"}],"payload":"{\"0\":{\"source_id\":0,\"obj_counter\":{\"person\":{\"max_val\":0}}},\"1\":{\"source_id\":1,\"obj_counter\":{\"person\":{\"max_val\":0}}}}","payloadType":"json","once":false,"repeat":"","crontab":"","x":160,"y":200,"wires":[["people-parse"]]},
  {"id":"people-missing","type":"inject","z":"people-tab","name":"Test: unavailable person measurement","props":[{"p":"payload"}],"payload":"{\"0\":{\"source_id\":0,\"obj_counter\":{}}}","payloadType":"json","once":false,"repeat":"","crontab":"","x":190,"y":240,"wires":[["people-parse"]]},
  {"id":"people-malformed","type":"inject","z":"people-tab","name":"Test: invalid serialized JSON","props":[{"p":"payload"}],"payload":"{not JSON","payloadType":"str","once":false,"repeat":"","crontab":"","x":170,"y":280,"wires":[["people-parse"]]},
  {"id":"people-parse","type":"json","z":"people-tab","name":"Ensure callback JSON object","property":"payload","action":"obj","pretty":false,"x":420,"y":160,"wires":[["people-adapter"]]},
  {"id":"people-adapter","type":"change","z":"people-tab","name":"Latest complete two-source snapshot","rules":[{"t":"set","p":"payload","pt":"msg","tot":"jsonata","to":"(\n $data := $type(payload) = \"array\" ? ($count(payload) > 0 ? payload[-1].data : {}) : payload;\n $assert($type($data) = \"object\", \"Expected source map or latest window\");\n $assert($count($keys($data)) = 2, \"Expected both configured sources\");\n [$map([0,1], function($sid) {(\n   $entry := $lookup($data, $string($sid));\n   $assert($type($entry) = \"object\" and $entry.source_id = $sid, \"Invalid or missing source\");\n   $value := $entry.obj_counter.person.max_val;\n   $assert($type($value) = \"number\", \"Person measurement unavailable\");\n   $assert($value >= 0 and $floor($value) = $value, \"Invalid person count\");\n   {\"source_id\": $sid, \"count\": $value}\n )})]\n)"}],"x":670,"y":160,"wires":[["people-counts","people-split"]]},
  {"id":"people-counts","type":"change","z":"people-tab","name":"Tag complete count array","rules":[{"t":"set","p":"topic","pt":"msg","to":"counts","tot":"str"}],"x":930,"y":80,"wires":[["people-ui"]]},
  {"id":"people-split","type":"split","z":"people-tab","name":"Split source records","property":"payload","arraySplt":1,"arraySpltType":"len","splt":"\\n","spltType":"str","stream":false,"x":910,"y":160,"wires":[["people-route"]]},
  {"id":"people-route","type":"switch","z":"people-tab","name":"Route sources to separate alarms","property":"payload.source_id","propertyType":"msg","rules":[{"t":"eq","v":"0","vt":"num"},{"t":"eq","v":"1","vt":"num"},{"t":"else"}],"checkall":"false","outputs":3,"x":1140,"y":160,"wires":[["people-command-0"],["people-command-1"],["people-unknown"]]},
  {"id":"people-command-0","type":"change","z":"people-tab","name":"Source 0 evaluate","rules":[{"t":"set","p":"source_id","pt":"msg","to":"0","tot":"num"},{"t":"set","p":"payload","pt":"msg","to":"{\"command\":\"evaluate\",\"value\":payload.count}","tot":"jsonata"}],"x":1400,"y":140,"wires":[["people-alarm-0"]]},
  {"id":"people-command-1","type":"change","z":"people-tab","name":"Source 1 evaluate","rules":[{"t":"set","p":"source_id","pt":"msg","to":"1","tot":"num"},{"t":"set","p":"payload","pt":"msg","to":"{\"command\":\"evaluate\",\"value\":payload.count}","tot":"jsonata"}],"x":1400,"y":220,"wires":[["people-alarm-1"]]},
  {"id":"people-alarm-0","type":"alarm","z":"people-tab","name":"Source 0 person count > 2","alarmType":"numeric","numericThreshold":"2","comparisonOperator":">","booleanTarget":"true","x":1640,"y":140,"wires":[["people-alarm-tag"]]},
  {"id":"people-alarm-1","type":"alarm","z":"people-tab","name":"Source 1 person count > 2","alarmType":"numeric","numericThreshold":"2","comparisonOperator":">","booleanTarget":"true","x":1640,"y":220,"wires":[["people-alarm-tag"]]},
  {"id":"people-alarm-tag","type":"change","z":"people-tab","name":"Tag alarm result with preserved source_id","rules":[{"t":"set","p":"topic","pt":"msg","to":"alarm","tot":"str"}],"x":1870,"y":160,"wires":[["people-ui"]]},
  {"id":"people-catch","type":"catch","z":"people-tab","name":"Parse/adapter/alarm failures","scope":["people-parse","people-adapter","people-command-0","people-command-1","people-alarm-0","people-alarm-1"],"uncaught":false,"x":680,"y":320,"wires":[["people-unknown","people-errors"]]},
  {"id":"people-unknown","type":"change","z":"people-tab","name":"Invalidate both sources on unavailable snapshot","rules":[{"t":"set","p":"topic","pt":"msg","to":"unknown","tot":"str"},{"t":"set","p":"payload","pt":"msg","to":"{\"state\":\"unknown\",\"source_ids\":[0,1],\"reason\":$exists(error.message) ? error.message : \"Unmapped source\"}","tot":"jsonata"}],"x":1030,"y":320,"wires":[["people-ui"]]},
  {"id":"people-errors","type":"debug","z":"people-tab","name":"Explicit unknown/error diagnostics","active":true,"complete":"true","targetType":"full","x":960,"y":380,"wires":[]},
  {"id":"people-ui","type":"uibuilder","z":"people-tab","name":"Approved synthetic dashboard target","url":"synthetic-people-count","fwdInMessages":false,"allowScripts":false,"allowStyles":false,"copyIndex":true,"templateFolder":"blank","x":2110,"y":160,"wires":[[],[]]}
]
